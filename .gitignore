## Ignore Visual Studio temporary files, build results, and local settings

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
[Ll]ib/
[xX]64/
[xX]86/
[Ww]in32/

# Visual Studio cache/options
.vs/
.vscode/
*.db
*.opendb
*.VC.db
*.VC.VC.opendb

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet packages
*.nupkg
packages/
*.snupkg

# Publish output
publish/

# Rider / ReSharper
.idea/
*.sln.iml

# OS generated files
.DS_Store
Thumbs.db
